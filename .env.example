# ==============================================================================
# NORTE INVEST (Método DAVI & Mecanismo Hydra) — Environment Variables Example
# ==============================================================================

# 1. Banco de Dados PostgreSQL Cloud (Supabase / Neon)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# 2. Segurança Bancária Zero-Trust
SESSION_SECRET="generate-a-random-64-character-hex-string-for-session-tokens"
TOTP_ENCRYPTION_KEY="generate-a-random-64-character-hex-string-for-aes-256-totp"
CRON_SECRET="norte-invest-cron-secret-key"

# 3. Integrações de Mercado & IA
BRAPI_TOKEN="your-brapi-api-token"
GEMINI_API_KEY="your-gemini-api-key"
