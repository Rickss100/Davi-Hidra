# ==============================================================================
# NORTE INVEST V2 ENTERPRISE — VARIÁVEIS DE AMBIENTE (.env.local)
# ==============================================================================

# 1. PostgreSQL (Supabase Cloud Connection Pooler / Direct URL)
# Deixe em branco em desenvolvimento local caso queira usar o PostgreSQL 16 embarcado (.pgdata)
DATABASE_URL=""

# 2. Chaves Criptográficas de Sessão (HttpOnly Cookie HMAC-SHA256 & Criptografia 2FA AES-256-GCM)
# Em produção, gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-64-byte-hex-secret-in-production"
TOTP_ENCRYPTION_KEY="replace-with-32-byte-hex-secret-in-production"

# 3. Provedores de Dados Financeiros & IA (Server-Only — nunca expostos ao cliente)
BRAPI_TOKEN=""
GEMINI_API_KEY=""

# 4. Segredo de Autenticação para Jobs de Cotações (/api/cron/prices)
CRON_SECRET="replace-with-cron-secret"
